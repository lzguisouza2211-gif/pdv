# Porta do servidor HTTP do WhatsApp backend (padrão: 3001)
WPP_PORT=3001

# Nível de log: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Origens permitidas no CORS (use * para liberar tudo em dev)
CORS_ORIGIN=http://localhost:5173

# Atendente IA — persistência de conversas (docs/atendente-ia-arquitetura.md)
# ATENÇÃO: SUPABASE_SERVICE_ROLE_KEY bypassa RLS. Nunca exponha no front-end,
# nunca comite o valor real (fica só no .env local, que é gitignored).
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
